APP_MODE=mock
API_PORT=8000
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=backstage
# Local rehearsal identities. Set your own tokens for any shared environment.
AUTH_TOKENS_JSON='{"demo-attendee":{"id":"attendee","tier":0},"demo-session":{"id":"speaker","tier":1,"session_ids":["session-room-b"]},"demo-staff":{"id":"venue-staff-01","tier":2,"domain":"venue"},"demo-backup":{"id":"venue-staff-02","tier":2,"domain":"venue"},"demo-organizer":{"id":"organizer","tier":3},"demo-camera":{"id":"camera","source_ids":["cam-b"],"room_ids":["room-b"]},"demo-it-staff":{"id":"it-staff-01","tier":2,"domain":"it"},"demo-it-backup":{"id":"it-staff-02","tier":2,"domain":"it"},"demo-badge-source":{"id":"badge-simulator","source_ids":["station-a","station-b"],"room_ids":["room-c"],"signal_kinds":["badge_health","badge_job_complete"]}}'
CORS_ALLOWED_ORIGINS=http://localhost:5173
BADGE_SERVICE_URL=http://localhost:8090
BADGE_INTERNAL_TOKEN=
PLANNER_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=
OTEL_SERVICE_NAME=incident-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Optional backend traces/logs/metrics to the existing internal collector (no vendor token here).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=incident-api
# Set service.version to the deployed commit; use deployment.environment.name=qa for synthetic QA.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Enable only after provisioning the matching <ELASTICSEARCH_INDEX_PREFIX>-incident-evidence alias.
EVIDENCE_PROJECTION_ENABLED=false
# Optional HTTPS Dash0 trace template with one {trace_id}; documented trace explorer query keys only, no credentials.
DASH0_TRACE_URL_TEMPLATE=
# Attendee-site pivot (contracts/pivot/README.md). Needs APP_MODE=live. Auto bootstrap creates only missing pivot indices.
PIVOT_ENABLED=false
PIVOT_AUTO_BOOTSTRAP=false
PIVOT_MAX_BUILDS_PER_HOUR=300
# on only where an inference endpoint backs semantic_text; any failure falls back to lexical.
PIVOT_SEMANTIC=off
