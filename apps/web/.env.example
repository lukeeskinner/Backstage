VITE_API_BASE_URL=/api/v1
VITE_MOCK_API=true
# Same-origin OTLP/HTTP traces path. Empty disables Dash0 browser monitoring.
# /otel is the dedicated base: SDK sends /otel/v1/traces and /otel/v1/logs.
# Legacy /v1/traces is translated to /otel; the proxy must support /otel/v1/*.
# Vite uses OTEL_PROXY_TARGET=http://127.0.0.1:4318 (server-side only).
# Cross-origin collector URLs are rejected. No replay, headers, identity or raw error messages.
# Never put a Dash0 token here; VITE_ values ship in the bundle.
VITE_BROWSER_OTLP_URL=

# Non-secret browser telemetry resource metadata.
VITE_SERVICE_VERSION=development
VITE_DEPLOYMENT_ENVIRONMENT=demo

# Optional local voice briefing. Off by default; requires the combined Node server below.
VITE_ENABLE_VOICE=false
# Export OPENAI_API_KEY in the Node server environment; never use a VITE_ variable for it.
# The server reads OPENAI_BRIEFING_MODEL, OPENAI_TRANSCRIBE_MODEL and OPENAI_DECISIONS_MODEL overrides.

# Vite process only (no credentials): optional local vision preview server.
# CAMERA_PROXY_TARGET=http://127.0.0.1:8766

# Optional Node-server-only rehearsal settings (never prefix these with VITE_).
# DEMO_OPERATOR_TOKEN: existing organizer bearer allowed to start a fixed rehearsal.
# DEMO_SIGNAL_TOKEN: existing cam-b/room-b zone_count producer bearer.
# Keep both in Kubernetes Secret web-rehearsal; do not commit values.
