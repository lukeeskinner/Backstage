{
  "name": "backstage-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test server/*.test.mjs",
    "presence": "node server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "preview": "vite preview",
    "record:tour": "node scripts/record-tour.mjs"
  },
  "dependencies": {
    "@dash0/sdk-web": "0.30.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
